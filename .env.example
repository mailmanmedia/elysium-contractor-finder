# Copy this file to ".env" and fill in keys as you obtain them.
# All keys are OPTIONAL. The app works without them (using free public sources).

# Socrata app token (Chicago Data Portal). Free, raises rate limit.
# Get one at: https://data.cityofchicago.org/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Google Places API key (paid, ~$17 per 1k requests).
GOOGLE_PLACES_API_KEY=

# Hunter.io email enrichment.
HUNTER_API_KEY=

# Apollo.io enrichment.
APOLLO_API_KEY=
